# Copy to .env and fill in the required values. docker compose reads this file.

# ---- Required
# Postgres password for the bundled database container
POSTGRES_PASSWORD=
# Encrypts workspace secrets (AI keys, GitLab tokens) at rest. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes previously stored secrets unreadable.
APP_SECRET_KEY=

# ---- Database / queue (defaults suit `python main.py` against the compose Postgres + Redis on localhost)
# DATABASE_URL=postgresql://sentinel:<POSTGRES_PASSWORD>@localhost:5432/sentinel
# CELERY_BROKER_URL=redis://localhost:6379/0
# POSTGRES_USER=sentinel
# POSTGRES_DB=sentinel
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
# API_WORKERS=2

# ---- Accounts
# Self-registration; verification codes are printed to the API console (docker compose logs -f api)
ALLOW_REGISTRATION=true
# Creates demo logins (login = password): demo (admin), alice and bob (write), carol (read), and the workspaces
# "Demo workspace", "Platform team" and "Data team". Turn off on anything reachable by others.
DEMO_USER_ENABLED=true
# Fill the demo workspaces with sample reviews, threat models, risks and controls on start (idempotent)
DEMO_SEED_DATA=true
# Set to true when serving over HTTPS
COOKIE_SECURE=false
# SESSION_TTL_HOURS=12
# MAX_LOGIN_FAILURES=5
# LOCKOUT_MINUTES=15
# ENABLE_DOCS=true

# ---- Workers and autoscaling
# Jobs per worker container; the autoscaler runs ceil((queued + running jobs) / WORKER_CONCURRENCY) containers
# WORKER_CONCURRENCY=2
# MIN_WORKERS=1
# MAX_WORKERS=6
# AUTOSCALE_POLL_SECONDS=10
# AUTOSCALE_SCALE_DOWN_DELAY=120
# JOB_TIME_LIMIT=7200
# AI calls one background job may make before it is stopped (0 = unlimited)
# JOB_MAX_AI_CALLS=300
# Parallel AI calls per batch AI review / devil's advocate job
# AI_BATCH_CONCURRENCY=5
# WORKER_STOP_GRACE=30m

# ---- AI defaults for new workspaces (each workspace sets its own provider, model and API keys in Settings)
# heuristic | openai | anthropic | gemini | ollama
AI_PROVIDER=heuristic
# Blank = provider default (gpt-4o-mini, claude-sonnet-4-5, gemini-2.5-flash, llama3.1)
AI_MODEL=
# Any OpenAI-compatible endpoint (Azure OpenAI, LM Studio, vLLM...)
OPENAI_BASE_URL=https://api.openai.com/v1
# From inside Docker use http://host.docker.internal:11434 to reach Ollama on the host
OLLAMA_BASE_URL=http://localhost:11434
# Default GitLab URL for workspace GitLab credentials
# GITLAB_BASE_URL=https://gitlab.com

# Seconds to wait for data from an AI provider before failing (default 300)
# AI_READ_TIMEOUT=300

# Optional path overrides
# CATALOG_PATH=data/catalog.json
# UPLOAD_DIR=data/uploads
