# Copy to .env - values here are defaults; the Settings page overrides them (stored in SQLite).

# heuristic | openai | anthropic | gemini | ollama
AI_PROVIDER=heuristic
# Blank = provider default (gpt-4o-mini, claude-sonnet-4-5, gemini-2.5-flash, llama3.1)
AI_MODEL=

OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (Azure OpenAI, LM Studio, vLLM...)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional path overrides
# DB_PATH=data/reviews.db
# CATALOG_PATH=data/catalog.json
